+# The allow + deny we want everywhere (catch-all + guardrails)
+read -r -d '' DESIRED_ALLOW <<'ALLOWJSON' || true
+["mcp__*","Read(**)","Edit(**)","Write(**)","Bash(*)"]
+ALLOWJSON
+
+read -r -d '' DESIRED_DENY <<'DENYJSON' || true
